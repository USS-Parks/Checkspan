{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checkspan.invalid/schemas/v1/graph-run.schema.json",
  "title": "GraphRun",
  "description": "One execution of one graph revision. Two runs of the same graph revision are distinct; a node's status and attempts belong to a run, never to the graph. Nothing from another run is reused unless it is listed as an admitted import.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record", "schema_version", "run_id", "graph_ref"],
  "properties": {
    "record": { "const": "graph_run" },
    "schema_version": { "const": 1 },
    "run_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "graph_ref": { "$ref": "graph-ref.schema.json" },
    "budget_lineage_ref": {
      "description": "Earlier run whose consumed budget this run inherits. A run cannot name itself.",
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "admitted_imports": {
      "description": "Accepted receipts from other runs, each explicitly admitted to stand in for one node of this run.",
      "type": "array",
      "items": { "$ref": "#/$defs/imported_receipt" }
    }
  },
  "$defs": {
    "imported_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "receipt", "result_digest", "result_type", "subject", "admitted_at"],
      "properties": {
        "node_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "receipt": { "$ref": "common.schema.json#/$defs/receipt_ref" },
        "result_digest": { "$ref": "common.schema.json#/$defs/digest" },
        "result_type": { "$ref": "common.schema.json#/$defs/type_ref" },
        "subject": { "$ref": "common.schema.json#/$defs/text" },
        "admitted_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "valid_until": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    }
  }
}
