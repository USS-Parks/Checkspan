{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checkspan.invalid/schemas/v1/gate-decision.schema.json",
  "title": "GateDecision",
  "description": "An authenticated decision bound to one gate packet by id and digest. Recording a decision means an authentic, well-formed decision exists; a denial is a valid decision, and no decision is a verifier verdict or a machine pass.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record", "schema_version", "gate_packet_id", "gate_packet_digest", "authority", "decided_at", "decision", "scope"],
  "properties": {
    "record": { "const": "gate_decision" },
    "schema_version": { "const": 1 },
    "gate_packet_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "gate_packet_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "level"],
      "properties": {
        "identity": { "$ref": "common.schema.json#/$defs/text" },
        "level": { "$ref": "common.schema.json#/$defs/provenance_level" }
      }
    },
    "decided_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "decision": { "enum": ["retry", "revise", "cancel", "approve_action", "deny_action", "record_assessment"] },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_matrix_digest", "reviewed_claim_ids", "outcome"],
      "properties": {
        "claim_matrix_digest": { "$ref": "common.schema.json#/$defs/digest" },
        "reviewed_claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/identifier" }
        },
        "outcome": { "enum": ["adequate_support", "inadequate_support", "cannot_determine"] },
        "rationale_ref": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "node"],
      "properties": {
        "run_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "node": { "$ref": "node-ref.schema.json" },
        "action": { "$ref": "gate-packet.schema.json#/$defs/action_request" }
      }
    },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "authorization_ref": { "$ref": "common.schema.json#/$defs/text" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "record_assessment" } } },
      "then": { "required": ["assessment"] },
      "else": { "not": { "required": ["assessment"] } }
    },
    {
      "if": { "properties": { "decision": { "enum": ["approve_action", "deny_action"] } } },
      "then": { "properties": { "scope": { "required": ["action"] } } },
      "else": { "properties": { "scope": { "not": { "required": ["action"] } } } }
    }
  ]
}
